# Copy to provision.local.env (gitignored, never committed) and fill in
# real values. Used by `make provision DEVICE=/dev/sdX` to fill in
# firstrun.sh on a freshly flashed card - see image/README.md.
#
# Quote every value. WIFI_PASS and SSH_PUBKEY can contain characters a
# shell would otherwise treat as special.

# Required. A card provisioned with this blank boots unreachable - no
# other remote access exists. e.g. the desktop-to-dietpi ed25519 key,
# already authorised on rig and gexis.
SSH_PUBKEY=""

# Optional - leave both blank for Ethernet-only.
WIFI_SSID=""
WIFI_PASS=""

# ISO 3166-1 alpha-2, required by set_wlan when WIFI_SSID is set. e.g. DE
WIFI_COUNTRY=""

# Optional - leave blank to keep the image's built-in default. e.g. gexis
HOSTNAME=""

# Optional - leave blank to keep the image default. e.g. Europe/Berlin
TIMEZONE=""

# Optional - the idle screen's page (ADR-0019). Kept here rather than in the
# image because a real URL can carry a per-display identifier. Blank shows
# the built-in clock.
IDLE_URL=""

# Optional - settings to start the device with, as JSON keyed by the settings
# screen's own keys, e.g. {"idle_timeout": 10, "drawer_autohide": 5}. The
# daemon treats these as defaults, so anything changed later from the phone
# still wins. Unknown keys and invalid values are logged and ignored.
SETTINGS=""
