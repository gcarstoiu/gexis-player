# Gexis panel settings, read by gexis-kiosk.service.
#
# Loopback on purpose: the panel's browser and the daemon serving it are
# the same machine (ADR-0028), so the panel never depends on the network
# being up, on mDNS resolving, or on this device's own name being right.
# A remote browser reaches the same page over the network instead
# (Phase 4 criterion 5).
GEXIS_KIOSK_URL=http://127.0.0.1:8090/

# Kept off the default ~/.config path so a factory reset or a wipe of
# browser state is one directory, and so nothing in it is mistaken for
# user configuration worth preserving.
GEXIS_KIOSK_PROFILE=/var/lib/gexis-kiosk

# Diagnostics only, empty by default: when set, the kiosk is started with
# Chromium's DevTools protocol on this port, bound to loopback. It is what
# Phase 7a's frame measurement drives the panel through, and what
# docs/findings/032 had to hand-edit the launcher for - a hand edit that
# then has to be remembered and undone. Leave it unset on a device anyone
# uses; anything that can reach the port can drive the browser.
# GEXIS_KIOSK_DEBUG_PORT=9222
