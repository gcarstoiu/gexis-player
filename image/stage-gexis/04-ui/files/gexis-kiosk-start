#!/bin/bash -e
# Run twice per start. First by gexis-kiosk.service as `gexis-kiosk-start
# compositor`: it writes labwc's configuration for the screen's port and
# becomes labwc. Then by labwc as its session (labwc -s), with no argument -
# everything below the two functions. When the session exits, labwc
# exits, so Chromium runs in the foreground deliberately: the compositor's
# lifetime is the browser's lifetime, and neither outlives the other as an
# invisible orphan.
#
# Flags, and why each is here rather than copied from a kiosk blog post:
#
#   --ozone-platform=wayland  labwc is Wayland-only; without this Chromium
#                             may pick X11 and find no display.
#   --kiosk                   fullscreen, no browser chrome, no way out.
#   --noerrdialogs,           an appliance has nobody to dismiss a dialog.
#   --disable-infobars        "Chrome is being controlled by..." and
#                             friends would sit over the UI forever.
#   --disable-session-crashed-bubble
#                             after an unclean shutdown - which is how this
#                             device is switched off, per ADR-0019's "the
#                             device is powered down at night by an
#                             external trigger" - Chromium otherwise opens
#                             asking whether to restore, on a screen with
#                             no keyboard.
#   --disable-component-update
#                             an appliance updates via the image, not by
#                             Chromium quietly fetching components.
#   --check-for-update-interval
#                             same reasoning, for the updater nag.
#   --disable-lcd-text        ADR-0061. Chromium keeps a scroll on the main
#                             thread rather than lose subpixel text on a
#                             scroller that is not opaque, and every screen
#                             here draws over a translucent veil - so every
#                             list paid, and a main-thread scroll re-rasters
#                             what it damages every frame. Without it the
#                             artist grid draws 25 frames a second and the
#                             queue rail 39; with it, both draw 57-58 and
#                             drop none (Finding 062). It is not clear the
#                             panel was getting subpixel text anyway.
#   --overscroll-history-navigation=0, --disable-pinch
#                             this is a touchscreen: a stray swipe must not
#                             navigate the SPA away, and pinch-zoom on a
#                             fixed 1280x800 layout only ever breaks it.
#   --autoplay-policy         nothing autoplays today, but the UI will own
#                             sound cues later and a user-gesture
#                             requirement has no user to gesture.

# **The HDMI port the screen is on** (ADR-0109; George, 2026-10-12: a panel
# on the second port was turned, touched and put to standby as if it were on
# the first). The core names it in screen.env; with no screen chosen, the
# first port a screen is connected to, as the core's own detection reads it;
# else HDMI-A-1. Only a name of that shape: it goes into an XML attribute.
screen_connector() {
	if [[ "${GEXIS_SCREEN_CONNECTOR:-}" =~ ^HDMI-A-[0-9]+$ ]]; then
		echo "${GEXIS_SCREEN_CONNECTOR}"
		return
	fi
	local status name
	for status in "${GEXIS_DRM:-/sys/class/drm}"/card*-HDMI-A-*/status; do
		[ "$(cat "${status}" 2>/dev/null)" = connected ] || continue
		name=${status%/status}
		name=${name##*/}
		name=${name#*-}
		[[ "${name}" =~ ^HDMI-A-[0-9]+$ ]] && { echo "${name}"; return; }
	done
	echo HDMI-A-1
}

# **labwc's configuration for that port.** Touch is tied to an output in
# rc.xml, which labwc reads before its session starts, so the configuration
# is written for the port and labwc pointed at it (-C). Everything labwc
# would otherwise read from /etc/xdg/labwc comes along, so the one change is
# the port. Off HDMI-A-1 the window is moved to the screen's output as well:
# with a second screen or a receiver on HDMI-A-1, labwc would open it there.
# On HDMI-A-1 the configuration is the installed one as it is.
write_labwc_config() {
	local dir=$1 source=${GEXIS_LABWC_SOURCE:-/etc/xdg/labwc} connector
	connector=$(screen_connector)
	# Written afresh every start: what the last start wrote is not this one's.
	[ -n "${dir}" ] && rm -rf "${dir}" && mkdir -p "${dir}" || return 1
	cp -R "${source}/." "${dir}/" || return 1
	sed -i -E "s/mapToOutput=\"[^\"]*\"/mapToOutput=\"${connector}\"/" "${dir}/rc.xml" || return 1
	# Off HDMI-A-1, or with something on the other port too (ADR-0141: a
	# sound bar on HDMI 2), labwc could open the window on the wrong output.
	local others=0 status
	for status in "${GEXIS_DRM:-/sys/class/drm}"/card*-HDMI-A-*/status; do
		[ "$(cat "${status}" 2>/dev/null)" = connected ] && others=$((others + 1))
	done
	if [ "${connector}" != HDMI-A-1 ] || [ "${others}" -gt 1 ]; then
		sed -i "s|</labwc_config>|  <windowRules>\n    <windowRule identifier=\"*\">\n      <action name=\"MoveToOutput\" output=\"${connector}\"/>\n    </windowRule>\n  </windowRules>\n</labwc_config>|" \
			"${dir}/rc.xml" || return 1
	fi
	grep -q "mapToOutput=\"${connector}\"" "${dir}/rc.xml" || return 1
	echo "gexis-kiosk: touch and the window on ${connector}" >&2
}

case "${1:-}" in
	compositor)
		# A configuration that cannot be written must not cost the panel:
		# labwc then reads the installed one, which is HDMI-A-1's.
		config="${XDG_RUNTIME_DIR:-/tmp}/gexis-labwc"
		if write_labwc_config "${config}"; then
			exec labwc -C "${config}" -s "$0"
		fi
		echo "gexis-kiosk: labwc's configuration for the screen's port not written; HDMI-A-1's" >&2
		exec labwc -s "$0"
		;;
	labwc-config)
		write_labwc_config "$2"
		exit
		;;
esac

# Empty unless /etc/gexis/kiosk.env sets it; see the comment there. An
# unset variable must add no flag at all, so it is built as an array rather
# than interpolated - an empty string in the argument list is an empty URL
# argument to Chromium, not nothing.
debug=()
if [ -n "${GEXIS_KIOSK_DEBUG_PORT:-}" ]; then
	debug=(--remote-debugging-port="${GEXIS_KIOSK_DEBUG_PORT}")
	echo "gexis-kiosk: DevTools protocol on port ${GEXIS_KIOSK_DEBUG_PORT}" >&2
fi

# The wallpaper behind Chromium, so the seconds between labwc taking the
# screen and the UI's first paint show the boot artwork rather than black
# (ADR-0043). Backgrounded deliberately: this script's exit is labwc's
# exit, so nothing here may block, and swaybg dies with the session.
#
# Failure is not fatal. A missing image or a missing swaybg costs a black
# gap, which is what we had before - it must never cost the panel.
# Timestamps into the journal, so the gap between the splash ending and the
# panel painting can be attributed rather than guessed at. labwc runs this
# script once the compositor is up, so the first line dates labwc's own
# start-up and the second dates chromium's exec.
echo "gexis-kiosk: compositor ready, session script running" >&2

BACKGROUND=/usr/share/gexis/panel-background.png
if [ -r "${BACKGROUND}" ] && command -v swaybg >/dev/null; then
	# A bar fits the still to its height, as the boot screens now do
	# (George, 2026-10-04); filling cut the logo. The colour is the still's
	# own ground, so the sides are seamless.
	# Only on the screen's own port: any other output - a sound bar or a
	# receiver on the other HDMI port - is black (ADR-0141 D3, George,
	# 2026-10-12: nothing to look at, no logo burnt into a TV). swaybg takes
	# `-o '*'` as every output without one of its own.
	screen_output=$(screen_connector)
	if [ "${GEXIS_SCREEN_FAMILY:-standard}" = bar ]; then
		swaybg -o '*' --color '#000000' \
			-o "${screen_output}" --mode fit --color '#101a21' --image "${BACKGROUND}" &
	else
		swaybg -o '*' --color '#000000' \
			-o "${screen_output}" --mode fill --image "${BACKGROUND}" &
	fi
else
	echo "gexis-kiosk: no wallpaper (${BACKGROUND}); the handover will be black" >&2
fi

# Chromium's profile lock is a symlink named `<hostname>-<pid>`, and on
# start it compares that hostname with this machine's. After a rename they
# differ, so it decides the profile is "in use by another Chromium process
# on another computer" and puts a dialog on the panel instead of the UI -
# on an appliance with no keyboard, with two buttons nobody can reach.
# George hit exactly this renaming the device to SofaPi (2026-09-21).
#
# Removing the three is safe here because **this unit is the only thing on
# the device that runs Chromium**, it is `Restart=no`, and systemd has
# already stopped the previous instance before this runs. There is no
# second browser whose lock this could be stealing.
rm -f "${GEXIS_KIOSK_PROFILE}/SingletonLock" \
	"${GEXIS_KIOSK_PROFILE}/SingletonCookie" \
	"${GEXIS_KIOSK_PROFILE}/SingletonSocket"

# ADR-0109: the attached screen (screen.env, from the core). The output is
# turned before Chromium starts - the bars are portrait panels used sideways -
# and Chromium's scale makes the page 1280 logical px wide on a Standard
# screen, 400 tall on a bar, drawn at the screen's own resolution.
scale=()
connector=$(screen_connector)
if [ -n "${GEXIS_SCREEN_TRANSFORM:-}" ] && [ "${GEXIS_SCREEN_TRANSFORM}" != normal ]; then
	if command -v wlr-randr >/dev/null; then
		wlr-randr --output "${connector}" --transform "${GEXIS_SCREEN_TRANSFORM}" \
			|| echo "gexis-kiosk: could not turn ${connector} to ${GEXIS_SCREEN_TRANSFORM}" >&2
	else
		echo "gexis-kiosk: wlr-randr missing; the screen stays unturned" >&2
	fi
fi
if [ -n "${GEXIS_SCREEN_SCALE:-}" ]; then
	scale=(--force-device-scale-factor="${GEXIS_SCREEN_SCALE}")
	echo "gexis-kiosk: ${GEXIS_SCREEN_ID:-screen} (${GEXIS_SCREEN_FAMILY:-standard}), scale ${GEXIS_SCREEN_SCALE}" >&2
fi
echo "gexis-kiosk: exec chromium" >&2

exec chromium \
	"${debug[@]}" \
	"${scale[@]}" \
	--ozone-platform=wayland \
	--kiosk \
	--noerrdialogs \
	--disable-infobars \
	--disable-session-crashed-bubble \
	--disable-component-update \
	--check-for-update-interval=31536000 \
	--overscroll-history-navigation=0 \
	--disable-lcd-text \
	--disable-pinch \
	--autoplay-policy=no-user-gesture-required \
	--user-data-dir="${GEXIS_KIOSK_PROFILE}" \
	"${GEXIS_KIOSK_URL}"
