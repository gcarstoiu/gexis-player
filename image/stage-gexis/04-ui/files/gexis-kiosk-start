#!/bin/bash -e
# Launched by labwc as its session (labwc -s). When this exits, labwc
# exits, so Chromium runs in the foreground deliberately: the compositor's
# lifetime is the browser's lifetime, and neither outlives the other as an
# invisible orphan.
#
# Flags, and why each is here rather than copied from a kiosk blog post:
#
#   --ozone-platform=wayland  labwc is Wayland-only; without this Chromium
#                             may pick X11 and find no display.
#   --kiosk                   fullscreen, no browser chrome, no way out.
#   --noerrdialogs,           an appliance has nobody to dismiss a dialog.
#   --disable-infobars        "Chrome is being controlled by..." and
#                             friends would sit over the UI forever.
#   --disable-session-crashed-bubble
#                             after an unclean shutdown - which is how this
#                             device is switched off, per ADR-0019's "the
#                             device is powered down at night by an
#                             external trigger" - Chromium otherwise opens
#                             asking whether to restore, on a screen with
#                             no keyboard.
#   --disable-component-update
#                             an appliance updates via the image, not by
#                             Chromium quietly fetching components.
#   --check-for-update-interval
#                             same reasoning, for the updater nag.
#   --disable-lcd-text        ADR-0061. Chromium keeps a scroll on the main
#                             thread rather than lose subpixel text on a
#                             scroller that is not opaque, and every screen
#                             here draws over a translucent veil - so every
#                             list paid, and a main-thread scroll re-rasters
#                             what it damages every frame. Without it the
#                             artist grid draws 25 frames a second and the
#                             queue rail 39; with it, both draw 57-58 and
#                             drop none (Finding 062). It is not clear the
#                             panel was getting subpixel text anyway.
#   --overscroll-history-navigation=0, --disable-pinch
#                             this is a touchscreen: a stray swipe must not
#                             navigate the SPA away, and pinch-zoom on a
#                             fixed 1280x800 layout only ever breaks it.
#   --autoplay-policy         nothing autoplays today, but the UI will own
#                             sound cues later and a user-gesture
#                             requirement has no user to gesture.
# Empty unless /etc/gexis/kiosk.env sets it; see the comment there. An
# unset variable must add no flag at all, so it is built as an array rather
# than interpolated - an empty string in the argument list is an empty URL
# argument to Chromium, not nothing.
debug=()
if [ -n "${GEXIS_KIOSK_DEBUG_PORT:-}" ]; then
	debug=(--remote-debugging-port="${GEXIS_KIOSK_DEBUG_PORT}")
	echo "gexis-kiosk: DevTools protocol on port ${GEXIS_KIOSK_DEBUG_PORT}" >&2
fi

# The wallpaper behind Chromium, so the seconds between labwc taking the
# screen and the UI's first paint show the boot artwork rather than black
# (ADR-0043). Backgrounded deliberately: this script's exit is labwc's
# exit, so nothing here may block, and swaybg dies with the session.
#
# Failure is not fatal. A missing image or a missing swaybg costs a black
# gap, which is what we had before - it must never cost the panel.
# Timestamps into the journal, so the gap between the splash ending and the
# panel painting can be attributed rather than guessed at. labwc runs this
# script once the compositor is up, so the first line dates labwc's own
# start-up and the second dates chromium's exec.
echo "gexis-kiosk: compositor ready, session script running" >&2

BACKGROUND=/usr/share/gexis/panel-background.png
if [ -r "${BACKGROUND}" ] && command -v swaybg >/dev/null; then
	swaybg --mode fill --image "${BACKGROUND}" &
else
	echo "gexis-kiosk: no wallpaper (${BACKGROUND}); the handover will be black" >&2
fi

# Chromium's profile lock is a symlink named `<hostname>-<pid>`, and on
# start it compares that hostname with this machine's. After a rename they
# differ, so it decides the profile is "in use by another Chromium process
# on another computer" and puts a dialog on the panel instead of the UI -
# on an appliance with no keyboard, with two buttons nobody can reach.
# George hit exactly this renaming the device to SofaPi (2026-09-21).
#
# Removing the three is safe here because **this unit is the only thing on
# the device that runs Chromium**, it is `Restart=no`, and systemd has
# already stopped the previous instance before this runs. There is no
# second browser whose lock this could be stealing.
rm -f "${GEXIS_KIOSK_PROFILE}/SingletonLock" \
	"${GEXIS_KIOSK_PROFILE}/SingletonCookie" \
	"${GEXIS_KIOSK_PROFILE}/SingletonSocket"

echo "gexis-kiosk: exec chromium" >&2

exec chromium \
	"${debug[@]}" \
	--ozone-platform=wayland \
	--kiosk \
	--noerrdialogs \
	--disable-infobars \
	--disable-session-crashed-bubble \
	--disable-component-update \
	--check-for-update-interval=31536000 \
	--overscroll-history-navigation=0 \
	--disable-lcd-text \
	--disable-pinch \
	--autoplay-policy=no-user-gesture-required \
	--user-data-dir="${GEXIS_KIOSK_PROFILE}" \
	"${GEXIS_KIOSK_URL}"
