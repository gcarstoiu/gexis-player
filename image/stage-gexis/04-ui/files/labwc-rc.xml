<?xml version="1.0"?>
<!--
  labwc configuration for the panel.

  Deliberately almost empty. This compositor has exactly one job: put one
  fullscreen Chromium window on one screen. Decorations, keybindings and
  window-management policy are all things an appliance panel has no use
  for, and every one of them left enabled is a way for a stray touch to
  produce a state nobody can account for (ADR-0010's rule, applied to the
  compositor rather than to playback).
-->
<labwc_config>
  <core>
    <decoration>none</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>
  <!-- No <keyboard> or <mouse> blocks: labwc's defaults include things
       like Alt+Tab and window drags. There is no keyboard attached, but
       there is a touchscreen, and "no bindings at all" is the state this
       panel should be in. -->
  <keyboard/>
  <!-- ADR-0109: the touchscreen tied to the panel's output, so a turned
       output (the bars are portrait panels used sideways) turns touch with
       it. HDMI-A-1 here; gexis-kiosk-start writes a copy of this file for
       the port the screen is on (George, 2026-10-12) and starts labwc on
       that copy. **Unverified until a bar is turned on the hardware**
       (ADR-0109, Unverified). -->
  <touch mapToOutput="HDMI-A-1"/>
  <!-- **Every window fills the screen it opens on** (sofapi, 2026-10-18): a
       window opened while the panel's was already up - the visualiser,
       started again on a phone's request - was placed by labwc at an offset,
       half off the screen. Maximize puts it at the screen's corner at the
       screen's size, whichever port the screen is on (MoveTo 0,0 would not:
       its coordinates are the whole layout's). gexis-kiosk-start adds the
       move to the screen's output before it, on the copy it writes. -->
  <windowRules>
    <windowRule identifier="*">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>
</labwc_config>
