+/* (Re)builds the FFT, its window and the band edges for this rate. Called
+   from update, once at the first and again only when the rate changes. */
+static int prepare_fft(unsigned int rate) {
+	unsigned int n = 1u << (unsigned int)lround(log2(rate / 10.77));
+	double high = BAND_HIGH_HZ;
+	release_fft();
+	if(high > 0.95 * rate / 2) {high = 0.95 * rate / 2;}
+	input_size = n;
+	output_size = n / 2 + 1;
+	input_buffer = (double*)fftw_malloc(n * sizeof(double));
+	output_buffer = (fftw_complex*)fftw_malloc(output_size * sizeof(fftw_complex));
+	history = (double*)calloc(n, sizeof(double));
+	window_n = (double*)malloc(n * sizeof(double));
+	if(input_buffer == NULL || output_buffer == NULL || history == NULL || window_n == NULL) {
+		release_fft();
+		return -1;
+	}
+	plan = fftw_plan_dft_r2c_1d(n, input_buffer, output_buffer, FFTW_ESTIMATE);
+	plan_made = 1;
+	for(unsigned int i = 0; i < n; i++) {
+		double x = (double)i / (n - 1);
+		if(window_function == 1) {window_n[i] = 0.5 - 0.5 * cos(2 * M_PI * x);}
+		else if(window_function == 2) {window_n[i] = 0.54 - 0.46 * cos(2 * M_PI * x);}
+		else if(window_function == 3) {window_n[i] = 0.42 - 0.5 * cos(2 * M_PI * x) + 0.08 * cos(4 * M_PI * x);}
+		else {window_n[i] = 1.0;}
+	}
+	for(int m = 0; m <= spectrum_size; m++) {
+		if(log_f < 1) {
+			band_edges[m] = high * m / spectrum_size;
+		} else {
+			band_edges[m] = BAND_LOW_HZ * pow(high / BAND_LOW_HZ, (double)m / spectrum_size);
+		}
+	}
+	for(int m = 0; m < spectrum_size; m++) {
+		double centre = sqrt(fmax(band_edges[m], 1.0) * band_edges[m + 1]);
+		double octaves = centre > LIFT_FROM_HZ ? log2(centre / LIFT_FROM_HZ) : 0;
+		band_gain[m] = pow(10, LIFT_DB * octaves / 20) / sqrt(n / REFERENCE_SIZE);
+	}
+	history_fill = 0;
+	fft_rate = rate;
+	return 0;
+}
+
+static void take(int16_t *left, int16_t *right, snd_pcm_uframes_t count) {
+	/* The newest input_size samples, oldest first. */
+	if(count >= input_size) {
+		left += count - input_size;
+		right += count - input_size;
+		count = input_size;
+	}
+	memmove(history, history + count, (input_size - count) * sizeof(double));
+	for(snd_pcm_uframes_t i = 0; i < count; i++) {
+		history[input_size - count + i] = (left[i] + right[i]) / 2.0;
+	}
+	history_fill += count;
+	if(history_fill > input_size) {history_fill = input_size;}
+}
