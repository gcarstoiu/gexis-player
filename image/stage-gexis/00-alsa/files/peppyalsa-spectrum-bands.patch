+/* Gexis (ADR-0130): the bands cover the same range at every sample rate,
+   BAND_LOW_HZ to BAND_HIGH_HZ, log-spaced, with a lift of LIFT_DB per octave
+   above LIFT_FROM_HZ. Upstream spread them from the second FFT bin to the
+   Nyquist frequency, so at 96 kHz the top bands were above anything
+   audible and at 44.1 kHz the last held 15-22 kHz, which recordings barely
+   reach; and with 512 points at 44.1 kHz the bass had one bar.
+
+   The FFT is sized to the rate - about 10.8 Hz a bin, 4096 points at 44.1
+   and 48 kHz - over the latest samples, kept in `history`, so the bass has
+   bins of its own; a frame is still made once per update, as before.
+   Band sums are divided by sqrt(input_size / 512) to stay on upstream's
+   scale for the level mapping below. */
+#define BAND_LOW_HZ 50.0
+#define BAND_HIGH_HZ 16000.0
+#define LIFT_FROM_HZ 1000.0
+#define LIFT_DB 3.0
+#define REFERENCE_SIZE 512.0
+
+static unsigned int input_size = 0;
 static unsigned int output_size;   
 static double* input_buffer;
