[Unit]
Description=go-librespot (Spotify Connect renderer)
Documentation=https://github.com/devgianlu/go-librespot
After=network-online.target avahi-daemon.service sound.target
Wants=network-online.target
# A misconfigured unit restarts forever otherwise, burying the real error
# in noise (hit this directly: 114 restarts in 25 minutes with no limit).
# 5 failures in 60s and systemd gives up, unit stays "failed" instead of
# spinning - StartLimit* is Unit-level, not Service-level.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# /home/pi is wrong for a system service's state - it's tied to a specific
# user account and, per install(1), install -D creates intermediate
# directories root-owned regardless of -o/-g on the target file, which is
# exactly what broke this (mkdir permission denied at first boot on
# gexis). StateDirectory= is systemd's own answer: /var/lib/go-librespot,
# created and (re-)chowned to User=/Group= on every start, survives the
# user account changing, self-healing against ownership drift.
StateDirectory=go-librespot
# --config_dir, not -config_dir: go-librespot parses -c as a distinct
# short flag for config overrides (field=value, see its own README) using
# POSIX-style bundling, not Go's stdlib flag package (which treats -x and
# --x identically). A single dash here gets parsed as -c "onfig_dir" -
# the leading "c" consumed as the flag, the rest as its argument - which
# is exactly the "invalid config override format: onfig_dir" failure
# found on gexis. Confirmed against go-librespot's own documented -c
# usage, not just inferred from the error text.
ExecStart=/usr/local/bin/go-librespot --config_dir /var/lib/go-librespot
Restart=on-failure
RestartSec=2
User=pi
Group=audio

[Install]
WantedBy=multi-user.target
