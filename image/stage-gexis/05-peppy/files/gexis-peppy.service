[Unit]
Description=Gexis Peppy screen (PeppyMeter, ADR-0026)
# The compositor owns the screen, so there is nothing to draw on without it.
After=gexis-kiosk.service gexis-core.service
Requires=gexis-kiosk.service
PartOf=gexis-kiosk.service

[Service]
Type=simple
User=pi
Group=pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/gexis-peppy-start
# Restart=no, like the kiosk unit and for the same reason: a failure that
# restarts in a loop is a failure nobody sees. journalctl -u gexis-peppy.
Restart=no

[Install]
WantedBy=multi-user.target
