[Unit]
Description=Lyrion Music Server (the Lyrion server plugin, ADR-0115)
Documentation=https://lyrion.org
After=network-online.target
Wants=network-online.target
# **ADR-0115 decision 11: Lyrion is fetched from the Lyrion community here, not
# shipped.** The first start downloads it, checks it and unpacks it into
# /opt/lyrion (gexis-fetch-component, ADR-0100); a later start compares.
Requires=gexis-fetch@lyrion.service
After=gexis-fetch@lyrion.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=squeezeboxserver
Group=nogroup
# Lyrion warns under the C locale that non-Latin file names may fail
# (seen 2026-10-02 in the arm64 builder): a music library has those.
Environment=LANG=C.UTF-8
# Its folders and first preferences, made here as root ("+") rather than only
# by the package: Remove deletes them (ADR-0115 decision 14), and the next
# start must find a new server's settings, not an empty folder. Database
# memory Normal under 4 GB (decision 19).
ExecStartPre=+/usr/lib/gexis/lyrion-prepare
# Lyrion's own places, as its Debian build has them: so its prefs, database
# and logs stay where Lyrion's documentation says they are.
ExecStart=/usr/bin/perl /opt/lyrion/slimserver.pl --prefsdir /var/lib/squeezeboxserver/prefs \
	--cachedir /var/lib/squeezeboxserver/cache --logdir /var/log/squeezeboxserver --charset utf8
# Upstream's own unit: SIGPIPE is Lyrion's, and HUP reinitialises it.
IgnoreSIGPIPE=no
SendSIGHUP=no
TimeoutStopSec=30
Restart=on-failure
RestartSec=10
# **Music comes first** (George, 2026-10-02: "music takes priority"): the
# server and its scanner get the processor and the card only when playback
# does not want them. Phase 13e criterion 2 measures that this is enough.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
# **The player's memory less 1 GB** (ADR-0115 decision 18), set by the line
# below at each start; 2 GB was too little for George's 61,362 files on a
# 4 GB Pi and more than a 2 GB Pi has. This share stands only if it fails.
MemoryMax=70%
ExecStartPre=+/usr/lib/gexis/lyrion-memory-limit

[Install]
WantedBy=multi-user.target
