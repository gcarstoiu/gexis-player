# ADR-0115 decision 11: Lyrion Music Server, fetched on the device from the
# Lyrion community when the user switches the server on - its notice restricts
# redistributing parts of it, so it is not in the image. The self-contained
# ARM build, which runs from its own folder on the system's Perl.
URL=https://downloads.lms-community.org/LyrionMusicServer_v9.1.1/lyrionmusicserver-9.1.1-arm-linux.tgz
SHA256=0b5b0c76e717d4c0fea8ffb8b6377e82d71204acba04fa73cf48ecca2d942690
FORMAT=tar.gz
DEST=/opt/lyrion
TOP=lyrionmusicserver-9.1.1-arm-linux
OWNER=squeezeboxserver:nogroup
LABEL="Lyrion Music Server 9.1.1"
FROM="the Lyrion community"
PLUGIN=lyrion-server
# ADR-0115 decision 14: Remove takes Lyrion's preferences and library too
# (the unit seeds the first preferences again at its next start).
DATA=/var/lib/squeezeboxserver/prefs:/var/lib/squeezeboxserver/cache
