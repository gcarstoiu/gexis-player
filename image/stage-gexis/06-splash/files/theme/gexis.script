// gexis boot splash (ADR-0043, amended 2026-09-20).
//
// A single still, not an animation. George, 2026-09-20, after three boots of
// the 100-frame sequence: "lets remove the animation and have a still
// instead ... no rings but the faded hallow in the background". The frame is
// the pulse's rest state - the mark, the wordmark, SOUND and the faded halo,
// nothing in motion - which is also what swaybg shows behind the compositor,
// so the splash and the wallpaper are now literally the same file.
//
// What this bought, beyond it being what was asked for: the initramfs drops
// from ~20MB to ~1MB, plymouth holds one image rather than a hundred (which
// retires ADR-0043's open question about ~400MB of decompressed frames), and
// there is no longer a loop whose wrap has to be pixel-identical or a join
// that has to be invisible.
//
// The animation is still renderable from files/render/ and is not built.

// #101a21 = (16, 26, 33). Plymouth cuts a colour's fraction off rather than
// rounding it, so 0.129 x 255 = 32.9 painted blue 32 beside the still's 33:
// a seam where a bar's still ends (George, 2026-10-10: "a separation line
// between the logo area ... and the side which is of different, really
// close though, colour"). These are (n + 0.3) / 255, safe either way - and
// the ground below is an image, so it is the still's colour exactly.
Window.SetBackgroundTopColor(0.0639, 0.1031, 0.1306);
Window.SetBackgroundBottomColor(0.0639, 0.1031, 0.1306);

// The whole window in the still's own ground, from an image rather than a
// colour, behind the still: the same pixels by the same path, so nothing
// where they meet can differ.
ground = Sprite(Image("ground.png").Scale(Window.GetWidth(), Window.GetHeight()));
ground.SetX(0);
ground.SetY(0);
ground.SetZ(-1);

// The still is 1280x800, scaled to fill whatever mode the screen comes up
// in - keeping its shape, cut evenly at the edges - and centred: what swaybg
// (`--mode fill`) and gexis-splash-fb draw after it, so the logo is one size
// from the first frame to the panel (George, 2026-10-03, on the 13.3" at
// 1920x1080: first "not centered", then centred but "towards the end the
// logo is zoomed in ... Either make all smaller or all larger. No mix").
// **A bar fits instead** (George, 2026-10-04: on the 11.9" the logo was
// "zoomed in a lot"): filling 320 px of height with an 800 px still cut the
// logo itself. A window at least 2.4 times as wide as tall is a bar
// (ADR-0109's boundary); the kernel's panel_orientation has already turned it
// landscape. The other two stages fit a bar too.
original = Image("still.png");
if (Window.GetWidth() >= 2.4 * Window.GetHeight()) {
    scale = Math.Min(Window.GetWidth() / original.GetWidth(), Window.GetHeight() / original.GetHeight());
} else {
    scale = Math.Max(Window.GetWidth() / original.GetWidth(), Window.GetHeight() / original.GetHeight());
}
still = original.Scale(Math.Int(original.GetWidth() * scale), Math.Int(original.GetHeight() * scale));
sprite = Sprite();
sprite.SetX(Math.Int((Window.GetWidth() - still.GetWidth()) / 2));
sprite.SetY(Math.Int((Window.GetHeight() - still.GetHeight()) / 2));
sprite.SetZ(0);
sprite.SetImage(still);

// No refresh function. There is nothing to advance, and plymouth is happy
// without one - the sprite is drawn once and stays.

// --- everything below draws nothing, on purpose -----------------------
//
// Leaving these undefined is NOT enough: plymouth falls back to its own
// rendering for any callback a theme does not take, and would draw fsck
// progress, password prompts and update messages over the still. George's
// requirement is that nothing textual appears during boot (ADR-0043).
//
// The cost is accepted knowingly: a boot that fails now shows the still
// rather than a reason, and SSH is the diagnostic path.

fun quiet() { }

Plymouth.SetBootProgressFunction(quiet);
Plymouth.SetRootMountedFunction(quiet);
Plymouth.SetSystemInitializedFunction(quiet);
Plymouth.SetUpdateStatusFunction(quiet);
Plymouth.SetDisplayNormalFunction(quiet);
Plymouth.SetDisplayPasswordFunction(quiet);
Plymouth.SetDisplayQuestionFunction(quiet);
Plymouth.SetMessageFunction(quiet);
Plymouth.SetHideMessageFunction(quiet);
Plymouth.SetDisplayCapsLockWarningFunction(quiet);

// On quit, leave the still fully opaque rather than fading it out: whatever
// is on screen at that moment is what the compositor has to draw over, and
// the closer it is to swaybg's own wallpaper the smaller the seam.
fun quit_callback() {
    sprite.SetOpacity(1);
}

Plymouth.SetQuitFunction(quit_callback);
