[Unit]
# ADR-0043's safety net.
#
# The splash is normally dropped by gexis-core, the moment the panel reports
# that it has painted its first frame. If the panel never paints - a broken
# UI, a Chromium that will not start, a daemon that is down - the animation
# would otherwise loop forever on a device with no keyboard, hiding the very
# failure somebody needs to see.
#
# 90s is well past the 19.7s this image takes to reach multi-user.target
# (Finding 038) plus the time Chromium needs after it, so this should never
# fire on a healthy boot. If it does, something is wrong and the console is
# the right thing to be looking at.
Description=Drop the boot splash if the panel never reports a first frame
After=multi-user.target
ConditionPathExists=/bin/plymouth

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 90
# --retain-splash leaves the last frame up rather than clearing to black:
# if the panel does paint late, it paints over the animation, not over a
# blank screen.
ExecStart=-/bin/plymouth quit --retain-splash
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
