[Unit]
# Fired by gexis-splash-backstop.timer, which has the reasoning. This unit
# does the work and nothing else - no sleeping, so nothing it does can hold
# the boot transaction open.
#
# Without this net a panel that never paints would loop the animation
# forever on a device with no keyboard, hiding the failure somebody needs to
# see. gexis-kiosk.service normally ends the splash itself, before labwc.
Description=Drop the boot splash if the panel never reported a first frame
ConditionPathExists=/bin/plymouth

[Service]
Type=oneshot
# --retain-splash leaves the last frame up rather than clearing to black: if
# the panel does paint late, it paints over the animation, not over a blank
# screen. `-` because a splash that has already gone is the normal case.
ExecStart=-/bin/plymouth quit --retain-splash
