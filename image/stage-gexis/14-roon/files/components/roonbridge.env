# ADR-0172: Roon Bridge, fetched from Roon Labs when the Roon plugin is
# switched on (ADR-0100), by gexis-fetch@roonbridge.service.
URL=https://download.roonlabs.net/builds/RoonBridge_linuxarmv8.tar.bz2
# Decision 5: Roon Labs serves only its latest build at this one address, so
# there is no version to pin; https from Roon Labs' host, and what was fetched
# is recorded. Roon Bridge updates itself after.
UNPINNED="ADR-0172 decision 5: Roon Labs serves only its latest build"
FORMAT=tar.bz2
DEST=/opt/RoonBridge
OWNER=roonbridge:roonbridge
LABEL="Roon Bridge"
FROM="Roon Labs"
PLUGIN=roon
