[Unit]
Description=Pause LMS as the device goes down, so nothing resumes by itself (George, 2026-09-29)
# Stopped before the core and the network go down: units stop in the reverse
# of their start order. Not bound to the core, so a core restart leaves it be.
After=gexis-core.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# ADR-0170: the route takes the panel's token, so that a plugin cannot park
# the renderers; root reads it as the kiosk does. On curl's input, not its
# command line, which any process can read (the review of 1.16.1).
ExecStop=/bin/sh -c 'echo "X-Gexis-Panel: $(cat /run/gexis/panel-token 2>/dev/null)" | /usr/bin/curl -s -m 5 -X POST -H @- http://127.0.0.1:8090/renderers/park'
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
