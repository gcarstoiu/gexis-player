[Unit]
Description=Gexis CPU governor: performance (ADR-0039)
Documentation=file:///etc/gexis/core.toml
# Nothing to wait for: the cpufreq policy exists as soon as the kernel is
# up, and every later unit benefits from the governor already being set.
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Every policy, not just cpu0: the Pi 4's four cores share one policy
# today, but writing each one costs nothing and does not assume that.
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'
User=root

[Install]
WantedBy=multi-user.target
