<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- ADR-0049 §4: avahi is already running here - it is how gexis.local
     resolves - so this is what puts the share in Finder's sidebar and in
     Windows' network view. nmbd runs too since 2026-10-16 (§4 as amended),
     for file managers that name machines only by NetBIOS. -->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=RackMac</txt-record>
  </service>
</service-group>
