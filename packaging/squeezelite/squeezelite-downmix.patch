--- /dev/null
+++ b/downmix.c
@@ -0,0 +1,187 @@
+/*
+ *  Squeezelite - lightweight headless squeezebox emulator
+ *
+ *  downmix: a file of more than two channels folded down to stereo.
+ *  Added by Gexis Player (ADR-0145), 2026. See downmix.h.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "downmix.h"
+
+#include <math.h>
+#include <string.h>
+
+#define SQRT1_2 0.70710678118654752440 // ffmpeg's centre and surround mix level, -3 dB
+
+static const char *const names[] = {
+	"FL", "FR", "FC", "LFE", "BL", "BR", "FLC", "FRC", "BC",
+	"SL", "SR", "TC", "TFL", "TFC", "TFR", "TBL", "TBC", "TBR", "?"
+};
+
+// Each position's share of left and right, before normalisation.
+static void coefficients(dm_speaker s, double *l, double *r) {
+	*l = *r = 0.0;
+	switch (s) {
+	case DM_FL:
+	case DM_FLC: *l = 1.0; break;
+	case DM_FR:
+	case DM_FRC: *r = 1.0; break;
+	case DM_FC:  *l = *r = SQRT1_2; break;
+	case DM_BL:
+	case DM_SL:  *l = SQRT1_2; break;
+	case DM_BR:
+	case DM_SR:  *r = SQRT1_2; break;
+	case DM_BC:  *l = *r = SQRT1_2 * SQRT1_2; break;
+	default:     break; // the LFE, the height channels and unknown ones are left out
+	}
+}
+
+bool downmix_init(struct downmix *dm, unsigned channels, const dm_speaker *speakers) {
+	double suml = 0.0, sumr = 0.0, norm;
+	unsigned c;
+
+	memset(dm, 0, sizeof(*dm));
+	if (channels < 3 || channels > DOWNMIX_MAX_CHANNELS) {
+		return false;
+	}
+	for (c = 0; c < channels; c++) {
+		dm_speaker s = (unsigned)speakers[c] < DM_UNKNOWN ? speakers[c] : DM_UNKNOWN;
+		dm->speaker[c] = s;
+		coefficients(s, &dm->l[c], &dm->r[c]);
+		suml += dm->l[c];
+		sumr += dm->r[c];
+		if (c) strcat(dm->layout, " ");
+		strcat(dm->layout, names[s]);
+	}
+	norm = suml > sumr ? suml : sumr;
+	if (norm <= 0.0) {
+		memset(dm, 0, sizeof(*dm));
+		return false;
+	}
+	// As ffmpeg's rematrix normalises an integer output: only ever down.
+	if (norm > 1.0) {
+		for (c = 0; c < channels; c++) {
+			dm->l[c] /= norm;
+			dm->r[c] /= norm;
+		}
+	}
+	dm->channels = channels;
+	return true;
+}
+
+bool downmix_init_default(struct downmix *dm, unsigned channels) {
+	static const dm_speaker orders[DOWNMIX_MAX_CHANNELS + 1][DOWNMIX_MAX_CHANNELS] = {
+		[3] = { DM_FL, DM_FR, DM_FC },
+		[4] = { DM_FL, DM_FR, DM_BL, DM_BR },
+		[5] = { DM_FL, DM_FR, DM_FC, DM_BL, DM_BR },
+		[6] = { DM_FL, DM_FR, DM_FC, DM_LFE, DM_BL, DM_BR },
+		[7] = { DM_FL, DM_FR, DM_FC, DM_LFE, DM_BC, DM_SL, DM_SR },
+		[8] = { DM_FL, DM_FR, DM_FC, DM_LFE, DM_BL, DM_BR, DM_SL, DM_SR },
+	};
+	if (channels < 3 || channels > DOWNMIX_MAX_CHANNELS) {
+		memset(dm, 0, sizeof(*dm));
+		return false;
+	}
+	return downmix_init(dm, channels, orders[channels]);
+}
+
+bool downmix_init_wav_mask(struct downmix *dm, unsigned channels, uint32_t mask) {
+	dm_speaker speakers[DOWNMIX_MAX_CHANNELS];
+	unsigned c = 0, bit;
+
+	mask &= (1u << DM_UNKNOWN) - 1; // bit 31 (SPEAKER_ALL) and reserved bits mean nothing here
+	if (!mask) {
+		return downmix_init_default(dm, channels);
+	}
+	if (channels < 3 || channels > DOWNMIX_MAX_CHANNELS) {
+		memset(dm, 0, sizeof(*dm));
+		return false;
+	}
+	for (bit = 0; bit < DM_UNKNOWN && c < channels; bit++) {
+		if (mask & (1u << bit)) {
+			speakers[c++] = (dm_speaker)bit;
+		}
+	}
+	while (c < channels) {
+		speakers[c++] = DM_UNKNOWN;
+	}
+	return downmix_init(dm, channels, speakers);
+}
+
+bool downmix_init_dsf(struct downmix *dm, unsigned channels, unsigned channel_type) {
+	static const struct { unsigned channels; dm_speaker order[6]; } types[8] = {
+		[3] = { 3, { DM_FL, DM_FR, DM_FC } },
+		[4] = { 4, { DM_FL, DM_FR, DM_BL, DM_BR } },
+		[5] = { 4, { DM_FL, DM_FR, DM_FC, DM_LFE } },
+		[6] = { 5, { DM_FL, DM_FR, DM_FC, DM_BL, DM_BR } },
+		[7] = { 6, { DM_FL, DM_FR, DM_FC, DM_LFE, DM_BL, DM_BR } },
+	};
+	if (channel_type < 8 && types[channel_type].channels && types[channel_type].channels == channels) {
+		return downmix_init(dm, channels, types[channel_type].order);
+	}
+	return downmix_init_default(dm, channels);
+}
+
+dm_speaker downmix_dsdiff_speaker(const unsigned char id[4]) {
+	if (!memcmp(id, "SLFT", 4) || !memcmp(id, "MLFT", 4)) return DM_FL;
+	if (!memcmp(id, "SRGT", 4) || !memcmp(id, "MRGT", 4)) return DM_FR;
+	if (!memcmp(id, "C   ", 4)) return DM_FC;
+	if (!memcmp(id, "LFE ", 4)) return DM_LFE;
+	if (!memcmp(id, "LS  ", 4)) return DM_BL;
+	if (!memcmp(id, "RS  ", 4)) return DM_BR;
+	return DM_UNKNOWN;
+}
+
+static inline int32_t clamp32(double v) {
+	if (v >= 2147483647.0) return INT32_MAX;
+	if (v <= -2147483648.0) return INT32_MIN;
+	return (int32_t)lrint(v);
+}
+
+void downmix_s32(const struct downmix *dm, const int32_t *const *in, size_t stride,
+				 unsigned shift, size_t frames, int32_t *out) {
+	const double scale = (double)((int64_t)1 << shift);
+	const unsigned channels = dm->channels;
+	size_t n;
+	unsigned c;
+
+	for (n = 0; n < frames; n++) {
+		double l = 0.0, r = 0.0;
+		for (c = 0; c < channels; c++) {
+			const double x = (double)in[c][n * stride] * scale;
+			l += dm->l[c] * x;
+			r += dm->r[c] * x;
+		}
+		*out++ = clamp32(l);
+		*out++ = clamp32(r);
+	}
+}
+
+void downmix_float(const struct downmix *dm, const float *const *in, size_t frames, int32_t *out) {
+	const unsigned channels = dm->channels;
+	size_t n;
+	unsigned c;
+
+	for (n = 0; n < frames; n++) {
+		double l = 0.0, r = 0.0;
+		for (c = 0; c < channels; c++) {
+			const double x = in[c][n];
+			l += dm->l[c] * x;
+			r += dm->r[c] * x;
+		}
+		*out++ = clamp32(l * 0x7fffffff);
+		*out++ = clamp32(r * 0x7fffffff);
+	}
+}
