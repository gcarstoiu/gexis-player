--- /dev/null
+++ b/downmix.h
@@ -0,0 +1,91 @@
+/*
+ *  Squeezelite - lightweight headless squeezebox emulator
+ *
+ *  downmix: a file of more than two channels folded down to stereo.
+ *  Added by Gexis Player (ADR-0145), 2026.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ * The fold-down is ITU-R BS.775's, as ffmpeg's default rematrix makes it:
+ *   left  = front left  + 0.7071 centre + 0.7071 each left surround (side, back)
+ *   right = front right + 0.7071 centre + 0.7071 each right surround
+ * a back centre goes to both at 0.5, a front left/right of centre to its
+ * side at 1, the LFE is left out. Every coefficient is then divided by the
+ * larger of the two sides' sums, so the largest possible sum is full scale:
+ * nothing can clip, at the cost of a quieter track.
+ *
+ * Depends on nothing of Squeezelite's, so it can be tested on its own.
+ */
+
+#ifndef DOWNMIX_H
+#define DOWNMIX_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define DOWNMIX_MAX_CHANNELS 8
+
+// Speaker positions, in the order of WAVE_FORMAT_EXTENSIBLE's channel mask
+// bits (bit n is position n), so a mask maps onto them directly.
+typedef enum {
+	DM_FL = 0, DM_FR, DM_FC, DM_LFE, DM_BL, DM_BR, DM_FLC, DM_FRC, DM_BC,
+	DM_SL, DM_SR, DM_TC, DM_TFL, DM_TFC, DM_TFR, DM_TBL, DM_TBC, DM_TBR,
+	DM_UNKNOWN
+} dm_speaker;
+
+struct downmix {
+	unsigned channels;
+	dm_speaker speaker[DOWNMIX_MAX_CHANNELS];
+	double l[DOWNMIX_MAX_CHANNELS];   // normalised: sum of either side's <= 1
+	double r[DOWNMIX_MAX_CHANNELS];
+	char layout[DOWNMIX_MAX_CHANNELS * 5 + 1]; // "FL FR FC LFE BL BR", for the log
+};
+
+// From explicit positions. False (nothing to fold) for fewer than three
+// channels, more than DOWNMIX_MAX_CHANNELS, or no channel that reaches
+// either side.
+bool downmix_init(struct downmix *dm, unsigned channels, const dm_speaker *speakers);
+
+// The order FLAC's specification gives for its channel count, which is also
+// WAVE_FORMAT_EXTENSIBLE's default (SMPTE) order:
+//   3: FL FR FC            4: FL FR BL BR          5: FL FR FC BL BR
+//   6: FL FR FC LFE BL BR  7: FL FR FC LFE BC SL SR
+//   8: FL FR FC LFE BL BR SL SR
+bool downmix_init_default(struct downmix *dm, unsigned channels);
+
+// A WAV file's dwChannelMask: channel n is the n-th set bit. A mask of 0
+// means the default order; a channel past the mask's bits is left out.
+bool downmix_init_wav_mask(struct downmix *dm, unsigned channels, uint32_t mask);
+
+// A DSF file's channel type (DSF specification 1.01): 3 FL FR FC, 4 quad,
+// 5 FL FR FC LFE, 6 FL FR FC BL BR, 7 5.1. Any other type: the default order.
+bool downmix_init_dsf(struct downmix *dm, unsigned channels, unsigned channel_type);
+
+// A DSDIFF channel ID (the CHNL chunk's four characters) as a position.
+dm_speaker downmix_dsdiff_speaker(const unsigned char id[4]);
+
+// Folds `frames` frames of integer samples into interleaved left/right
+// 32-bit samples at `out`. Sample n of channel c is in[c][n * stride]
+// (stride 1: planar; stride = channels: interleaved); each is multiplied by
+// 2^shift first, so a sample of b bits with shift 32 - b is full scale in
+// 32 bits. Computed in double precision, rounded to nearest, clamped.
+void downmix_s32(const struct downmix *dm, const int32_t *const *in, size_t stride,
+				 unsigned shift, size_t frames, int32_t *out);
+
+// The same for planar float samples of full scale 1.0, written as 32-bit
+// samples scaled by 0x7fffffff (as dsd.c scales its stereo PCM).
+void downmix_float(const struct downmix *dm, const float *const *in, size_t frames, int32_t *out);
+
+#endif
