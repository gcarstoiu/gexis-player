      {
        "key": "artwork_lookup",
        "type": "toggle",
        "label": "Look up missing artwork",
        "marks": "R",
        "note": "For renderers that supply none. Title and artist are enough to find it later.",
        "default": null
      },
      {
        "key": "listenbrainz_token",
        "type": "text",
        "secret": true,
        "placeholder": "ListenBrainz token",
        "label": "ListenBrainz token",
