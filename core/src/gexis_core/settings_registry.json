  {
    "id": "device",
    "label": "Device",
    "subtitle": "Identity and network",
    "accent": "#8fc4d8",
    "rows": [
      {
        "key": "device_name",
        "type": "text",
        "label": "Device name",
        "marks": "R",
        "note": "One name for everything: the mDNS hostname, the LMS player, the Spotify Connect device and the Bluetooth name. There is no per-service override. Changing it takes effect at the next restart.",
        "default": null,
        "restart": true,
        "placeholder": "Device name"
      },
      {
        "key": "wifi",
        "type": "list",
        "label": "Wi-Fi",
        "marks": "R",
        "note": null,
        "default": null,
