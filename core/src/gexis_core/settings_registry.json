      {
        "key": "fanart_key",
        "type": "text",
        "secret": true,
        "placeholder": "fanart.tv key",
        "label": "fanart.tv key",
        "marks": "N",
        "note": "Artist pictures. Without it they come from LMS's own plugin, where the server has one, and initials otherwise.",
        "default": null
      }
    ]
