      {
        "key": "idle_timeout",
        "type": "number",
        "label": "Timeout",
        "marks": "R",
        "note": "One timeout on every screen, counted while nothing is playing and nobody touches the panel.",
        "min": 1,
        "max": 60,
        "unit": "min",
        "default": 5
