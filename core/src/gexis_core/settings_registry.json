[
  {
    "id": "audio",
    "label": "Audio",
    "subtitle": "Level and output",
    "accent": "#7ed6bc",
    "rows": [
      {
        "key": "output_mode",
        "type": "choice",
        "label": "Output mode",
        "marks": "R",
        "note": "Only variable is built and hardware-verified. Fixed hides the volume control everywhere and applies after stop.",
        "options": [
          "Variable",
          "Fixed"
        ],
        "default": "Variable",
        "warn": {
          "Fixed": "Fixed output sends the signal at 100%. Turn your amplifier down before confirming — the panel can no longer lower it."
        }
      },
      {
        "key": "boot_volume",
        "type": "number",
        "label": "Boot volume",
        "marks": "RH",
        "note": "A fixed safe level at every cold boot, never the last session’s.",
        "min": -90,
        "max": -20,
        "unit": "dB",
        "default": -90
      },
      {
        "key": "max_ceiling",
        "type": "number",
        "label": "Maximum ceiling",
        "marks": "R?",
        "note": null,
        "min": -60,
        "max": 0,
        "unit": "dB",
        "default": null
      },
      {
        "key": "restore_floor",
        "type": "number",
        "label": "Restore floor",
        "marks": "RH?",
        "note": "Placeholder, never confirmed. Measured too quiet for Bluetooth’s unmanaged floor.",
        "min": -60,
        "max": -10,
        "unit": "dB",
        "default": -40,
        "surfaced": false
      },
      {
        "key": "boot_default_scope",
        "type": "choice",
        "label": "Boot default applies",
        "marks": "R?",
        "note": "A renderer’s first use mid-session currently starts as quiet as a power-on.",
        "options": [
          "Cold boot only",
          "Every renderer start"
        ],
        "default": "Cold boot only",
        "surfaced": false
      },
      {
        "key": "per_renderer_volume",
        "type": "toggle",
        "label": "Remember level per renderer",
        "marks": "RH",
        "note": null,
        "default": true
      },
      {
        "key": "volume_managed",
        "type": "readonly",
        "label": "Volume-managed renderers",
        "marks": "RH",
        "note": "Bluetooth excluded pending Finding 006.",
        "default": "LMS, Spotify",
        "surfaced": false
      },
      {
        "key": "travel_curve",
        "type": "choice",
        "label": "Slider travel curve",
        "marks": "RH",
        "note": "Decided: the slider spans −45 to 0 dB, even in dB, and shows its position.",
        "options": [
          "dB-linear",
          "Perceptual"
        ],
        "default": "dB-linear"
      }
    ]
  },
  {
    "id": "sources",
    "label": "Sources",
    "subtitle": "Renderers and services",
    "accent": "#9fb4e8",
    "rows": [
      {
        "type": "group",
        "label": "LMS",
        "accent": "#7ed6bc"
      },
      {
        "key": "lms_enabled",
        "type": "toggle",
        "label": "Enabled",
        "marks": "R",
        "note": null,
        "default": true
      },
      {
        "key": "lms_server",
        "type": "list",
        "label": "Server",
        "marks": "RH",
        "note": "Servers announce themselves on the network. Typing an address is the fallback, not the route.",
        "default": null,
        "empty": "No servers found. Check the server is running, or enter its address by hand.",
        "kind": "server",
        "discover": true,
        "manual": "Enter an address"
      },
      {
        "key": "lms_player",
        "type": "text",
        "label": "Player name",
        "marks": "H",
        "note": null,
        "default": null,
        "surfaced": false
      },
      {
        "key": "plugins",
        "type": "action",
        "label": "Plugins",
        "marks": "R",
        "note": null,
        "default": null,
        "surfaced": false
      },
      {
        "type": "group",
        "label": "Spotify Connect",
        "accent": "#7ed6bc"
      },
      {
        "key": "spotify_enabled",
        "type": "toggle",
        "label": "Enabled",
        "marks": "R",
        "note": null,
        "default": true
      },
      {
        "key": "spotify_name",
        "type": "readonly",
        "label": "Advertised name",
        "marks": "R",
        "note": "Follows the device name.",
        "default": null,
        "surfaced": false
      },
      {
        "type": "group",
        "label": "Bluetooth",
        "accent": "#9fb4e8"
      },
      {
        "key": "bt_enabled",
        "type": "toggle",
        "label": "Enabled",
        "marks": "R",
        "note": null,
        "default": true
      },
      {
        "key": "bt_pairing",
        "type": "choice",
        "label": "Pairing",
        "marks": "R",
        "note": "Confirmation shows a six-digit code on the panel and waits for it to be accepted. PIN-free pairs anything in range without asking.",
        "options": [
          "Confirmation required",
          "PIN-free"
        ],
        "default": "Confirmation required"
      },
      {
        "key": "bt_discoverable",
        "type": "choice",
        "label": "Discoverable",
        "marks": "R",
        "note": null,
        "options": [
          "Always",
          "3 min after boot",
          "Off"
        ],
        "default": "3 min after boot"
      },
      {
        "key": "bt_trusted",
        "type": "list",
        "label": "Trusted devices",
        "marks": "R",
        "note": "View and forget remembered devices. Clearing breaks automatic reconnection.",
        "default": null,
        "empty": "No devices paired yet. Put this device in pairing mode from your phone.",
        "kind": "device"
      },
      {
        "key": "bt_autotrust",
        "type": "toggle",
        "label": "Auto-trust on pair",
        "marks": "H",
        "note": "Remembers a device once its pairing is confirmed, so it reconnects on its own. Off means every connection is a fresh pair.",
        "default": true
      }
    ]
  },
  {
    "id": "handoff",
    "label": "Handoff",
    "subtitle": "Who gets the device",
    "accent": "#e0a758",
    "rows": [
      {
        "key": "restore_transport",
        "type": "choice",
        "label": "Restore transport on return",
        "marks": "RH",
        "note": null,
        "options": [
          "Play only if playing",
          "Always pause",
          "Always play"
        ],
        "default": "Play only if playing"
      },
      {
        "key": "seek_reanchor",
        "type": "toggle",
        "label": "Re-anchor seek position",
        "marks": "R?",
        "note": "Pressing play on a deactivated player currently loses the position entirely.",
        "default": false,
        "surfaced": false
      },
      {
        "key": "reclaim_lms",
        "type": "toggle",
        "label": "Reclaim LMS when a session ends",
        "marks": "N",
        "note": "Never done by design. Opting in reintroduces the spurious reclaims that were measured.",
        "default": false
      },
      {
        "key": "release_ladder",
        "type": "readonly",
        "label": "Release ladder",
        "marks": "H",
        "note": "Polite stop, then SIGTERM, then SIGKILL.",
        "default": null,
        "surfaced": false
      },
      {
        "key": "idle_close",
        "type": "number",
        "label": "squeezelite idle close",
        "marks": "RH",
        "note": null,
        "min": 0,
        "max": 30,
        "unit": "s",
        "default": 1,
        "surfaced": false
      },
      {
        "key": "show_transition",
        "type": "toggle",
        "label": "Show transition screen",
        "marks": "N",
        "note": null,
        "default": true
      },
      {
        "key": "handoff_threshold",
        "type": "number",
        "label": "Transition screen threshold",
        "marks": "RH?",
        "note": "Pairs earn exemption by measurement rather than preference.",
        "min": 0,
        "max": 5,
        "unit": "s",
        "default": 1,
        "onlyWhen": [
          "show_transition",
          true
        ]
      },
      {
        "key": "handoff_duration",
        "type": "number",
        "label": "Transition screen length",
        "marks": "N",
        "note": "How long the takeover animation stays up once it is shown.",
        "min": 1,
        "max": 5,
        "step": 0.5,
        "unit": "s",
        "default": 2.5,
        "onlyWhen": [
          "show_transition",
          true
        ]
      }
    ]
  },
  {
