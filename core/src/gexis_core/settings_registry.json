        "key": "enrichment",
        "type": "toggle",
        "label": "Enrichment",
        "marks": "R",
        "note": null,
        "default": null
      },
      {
        "key": "confidence",
        "type": "number",
        "label": "Confidence threshold",
        "marks": "R",
        "note": "Below it nothing is shown — a confidently wrong biography is worse than a blank panel.",
        "min": 0,
        "max": 1,
        "unit": "",
        "step": 0.05,
        "default": null,
        "surfaced": false
      },
      {
        "key": "lyrics",
        "type": "toggle",
        "label": "Lyrics",
        "marks": "R",
        "note": null,
        "default": null
