[
  {
    "id": "audio",
    "label": "Audio",
    "subtitle": "Level and output",
    "accent": "#7ed6bc",
    "rows": [
      {
        "key": "output_device",
        "type": "choice",
        "label": "Output",
        "marks": "R",
        "note": "Where the sound goes. **HDMI costs three things**: it has no volume control of its own, so the level is fixed; the Pi carries HDMI audio in a format that has to be converted to, so it is no longer bit-perfect; and the visualiser gets no levels from it. The headphone jack and the DAC keep all three.",
        "optionsFrom": "output_device",
        "default": null,
        "warn": "Changing the output stops whatever is playing while the sound card is reopened. An output with no volume control of its own — either HDMI — also takes the volume control off the panel."
      },
      {
        "key": "output_mode",
        "type": "choice",
        "label": "Output mode",
        "marks": "R",
        "note": "Only variable is built and hardware-verified. Fixed hides the volume control everywhere and applies after stop.",
        "options": [
          "Variable",
          "Fixed"
        ],
        "default": "Variable",
        "warn": {
          "Fixed": "Fixed output sends the signal at 100%. Turn your amplifier down before confirming — the panel can no longer lower it."
        }
      },
      {
        "key": "max_ceiling",
        "type": "number",
        "label": "Maximum volume",
        "marks": "R",
        "note": "The loudest the device will go, on any input. Set it to 80 and the device is never louder than the slider at 80 — and 100% on the panel, in LMS and on a connected phone all mean that level, so no control shows a number louder than what comes out.",
        "min": 10,
        "max": 100,
        "unit": "%",
        "default": null
      },
      {
        "key": "volume_managed",
        "type": "readonly",
        "label": "Volume-managed renderers",
        "marks": "R",
        "note": "Bluetooth excluded pending Finding 006.",
        "default": "LMS, Spotify",
        "surfaced": false
      },
      {
        "key": "travel_curve",
        "type": "choice",
        "label": "Volume curve",
        "marks": "R",
        "note": "How the slider's travel maps to loudness, over 60 dB either way. Cubic is the shape a volume control usually has — half travel is −15.5 dB. Linear spreads the decibels evenly instead, which puts half travel at −30 dB and makes the bottom of the slider very quiet.",
        "options": [
          "Cubic",
          "Linear (dB)"
        ],
        "default": "Cubic"
      }
    ]
  },
