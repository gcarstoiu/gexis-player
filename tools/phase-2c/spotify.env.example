# Copy to spotify.local.env (gitignored, never committed) and fill in
# real values. Used by the criterion 7/8 test harnesses to drive Spotify
# Connect acquisition (PUT /me/player, "transfer playback") without a
# phone. Same shape as image/provision.env.example's credential handling.
#
# Obtained via a one-time PKCE authorization against the gexis-player
# Spotify app (developer.spotify.com), scopes: user-modify-playback-state
# user-read-playback-state. See docs/DEVELOPMENT.md / HANDOFF.md for how
# this was done.

SPOTIFY_CLIENT_ID=""
SPOTIFY_REFRESH_TOKEN=""

# Fallback only - spotify_api.py resolves "gexis" by name from
# GET /v1/me/player/devices on every call, since go-librespot generates a
# fresh zeroconf device id on every reflash (nothing persists across a
# rootfs replacement) and a cached id here would go stale exactly like
# Finding 005's card-index and the pre-pinning ephemeral-port issue.
# A fresh reflash also needs one manual pairing from a phone (Spotify app,
# select "gexis" from the device picker) before the name lookup finds
# anything at all - the Web API can't bootstrap that handshake itself.
SPOTIFY_GEXIS_DEVICE_ID=""
