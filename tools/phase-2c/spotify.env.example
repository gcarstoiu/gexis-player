# Copy to spotify.local.env (gitignored, never committed) and fill in
# real values. Used by the criterion 7/8 test harnesses to drive Spotify
# Connect acquisition (PUT /me/player, "transfer playback") without a
# phone. Same shape as image/provision.env.example's credential handling.
#
# Obtained via a one-time PKCE authorization against the gexis-player
# Spotify app (developer.spotify.com), scopes: user-modify-playback-state
# user-read-playback-state. See docs/DEVELOPMENT.md / HANDOFF.md for how
# this was done.

SPOTIFY_CLIENT_ID=""
SPOTIFY_REFRESH_TOKEN=""

# The device_id of "gexis" as reported by GET /v1/me/player/devices -
# stable per-install, but re-check if go-librespot's zeroconf identity
# ever changes.
SPOTIFY_GEXIS_DEVICE_ID=""
